# Optional local override — shell-exported keys are enough.
# Next.js also loads .env.local if present (never commit real keys).

# Vercel AI Gateway — required for AI import (/api/import)
AI_GATEWAY_API_KEY=

# Google Gemini — required for Voice mode (/api/voice/live/token)
# Same keys aitools voice uses. GOOGLE_API_KEY is an accepted alias.
GEMINI_API_KEY=
# GOOGLE_API_KEY=
# Optional override (default: gemini-3.1-flash-live-preview)
# GEMINI_LIVE_MODEL=
# NEXT_PUBLIC_GEMINI_LIVE_MODEL=
